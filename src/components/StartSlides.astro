---
// 1편·2편의 첫 장면으로 바로 들어가는 시작 카드. 번호는 원본 장면 데이터에서 계산한다.
import { chapters, parts, scenes } from '../generated/slides.json';
const starts = Object.entries(parts).map(([part, info]) => {
  const first = scenes.find((scene) => chapters[scene.ch]?.p === Number(part));
  const count = scenes.filter((scene) => chapters[scene.ch]?.p === Number(part)).length;
  return { part, info, href: `/ai/spatial-sense/#${first?.number ?? 1}`, count };
});
---
<div class="starts not-content">
  {starts.map(({ info, href, count }) => (
    <a class="part" href={href}>
      <span class="series"><b>{info[0]}</b> AI의 지능은 공간감각이다</span>
      <strong>{info[1]}</strong>
      <span class="topics">{info[2]}</span>
      <span class="meta">{count}장면 · {info[3]} <b aria-hidden="true">시작 →</b></span>
    </a>
  ))}
</div>
<p class="more"><a href="/ai/spatial-sense-guide/">전체 장면 목차에서 원하는 장면 고르기</a></p>

<style>
  .starts { display: grid; grid-template-columns: repeat(auto-fit,minmax(min(100%,15rem),1fr)); gap: .85rem; }
  .part {
    display: flex; flex-direction: column; align-items: stretch; gap: .45rem;
    padding: 1.125rem; border: 1px solid var(--study-separator); border-radius: 18px;
    background: var(--study-surface); color: var(--sl-color-white); text-decoration: none;
  }
  .series { display: flex; gap: .5rem; align-items: center; color: var(--study-secondary); font-size: .8125rem; font-weight: 550; }
  .series b { flex-shrink: 0; border-radius: 6px; padding: .1rem .45rem; background: var(--sl-color-accent-low); color: var(--sl-color-accent-high); }
  strong { margin-top: .2rem; font-size: 1.0625rem; line-height: 1.4; letter-spacing: -.02em; }
  .topics { color: var(--study-secondary); font-size: .9375rem; line-height: 1.4; }
  .meta { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .25rem; margin-top: auto; padding-top: .9rem; color: var(--study-secondary); font-size: .8125rem; }
  .meta b { color: var(--sl-color-text-accent); font-weight: 650; }
  .part:hover, .part:focus-visible { border-color: var(--sl-color-text-accent); }
  .part:hover strong { text-decoration: underline; }
  .more { margin: .3rem 0 0; }
  .more a { display: inline-flex; align-items: center; min-height: 44px; font-size: .9375rem; }
</style>
