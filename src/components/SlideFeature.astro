---
import { scenes } from '../generated/slides.json';
const lessonCount = scenes.filter((scene) => scene.ch !== 0).length;
---
<section class="feature not-content" aria-labelledby="feature-title">
  <div class="story">
    <p class="format">인터랙티브 슬라이드 <span>·</span> {lessonCount}장면</p>
    <h2 id="feature-title">AI의 지능은<br />공간감각이다</h2>
    <p class="description">AI가 말을 이해하는 방식을 한 장면씩 만져 보는 첫 학습 자료입니다.</p>
    <div class="actions">
      <a class="start" href="/ai/spatial-sense/">
        <svg aria-hidden="true" width="13" height="14" viewBox="0 0 13 14"><path d="M2 2.2c0-.9.8-1.3 1.5-.9l7.7 4.8c.7.4.7 1.4 0 1.8l-7.7 4.8c-.7.4-1.5 0-1.5-.9z" fill="currentColor"/></svg>
        AI 슬라이드 바로 시작
      </a>
      <a class="contents" href="/ai/spatial-sense-guide/">전체 장면 목차 <span aria-hidden="true">›</span></a>
    </div>
  </div>
  <svg class="atlas" aria-hidden="true" width="350" height="246" viewBox="0 0 350 246" fill="none">
    <defs>
      <linearGradient id="sheet" x1="0" y1="0" x2="1" y2="1" gradientUnits="objectBoundingBox">
        <stop stop-color="#ad9bfc" stop-opacity=".47" /><stop offset="1" stop-color="#6451b7" stop-opacity=".2" />
      </linearGradient>
      <pattern id="lattice" width="20" height="20" patternUnits="userSpaceOnUse">
        <path d="M20 0H0V20" stroke="#ddd4ff" stroke-opacity=".54" stroke-width=".9" />
      </pattern>
    </defs>
    <!-- Three projected coordinate planes. The points above them trace a word vector. -->
    <g transform="matrix(.96 .36 -.86 .44 169 112)">
      <rect width="160" height="140" rx="7" fill="#453b7e" stroke="#9585d5" />
      <rect width="160" height="140" rx="7" fill="url(#lattice)" opacity=".5" />
    </g>
    <g transform="matrix(.96 .36 -.86 .44 169 86)">
      <rect width="160" height="140" rx="7" fill="#65589d" stroke="#bdabf4" />
      <rect width="160" height="140" rx="7" fill="url(#lattice)" opacity=".65" />
    </g>
    <g transform="matrix(.96 .36 -.86 .44 169 60)">
      <rect width="160" height="140" rx="7" fill="#5c4a9b" /><rect width="160" height="140" rx="7" fill="url(#sheet)" />
      <rect width="160" height="140" rx="7" fill="url(#lattice)" stroke="#ede4ff" stroke-width="1.35" />
    </g>
    <g stroke="#e5d8ff" stroke-width="1.2" stroke-dasharray="3 4">
      <path d="M94 100v23m47-49v45m53-76v70m50-28v46m30-43v27" />
    </g>
    <g stroke-linejoin="round">
      <path d="m94 100 47-26 53-31 50 42 30 3-58 13-75-27 31 20 22-51" fill="#c3afff" fill-opacity=".17" stroke="#c6b2fa" />
      <path d="m94 100 78-6 44 7 28-16" stroke="#b7acff" />
      <path d="m141 74 53-31 50 42" stroke="#fff0be" stroke-width="2.1" />
    </g>
    <g fill="#e4dbff" stroke="#51457f" stroke-width="1.4">
      <circle cx="94" cy="100" r="3.7"/><circle cx="141" cy="74" r="4.7"/><circle cx="172" cy="94" r="3.2"/>
      <circle cx="216" cy="101" r="3"/><circle cx="244" cy="85" r="4"/><circle cx="274" cy="88" r="3.7"/>
    </g>
    <circle cx="194" cy="43" r="9.5" stroke="#ffdda4" stroke-opacity=".5" />
    <circle cx="194" cy="43" r="4.8" fill="#ffe1ac" />
  </svg>
</section>

<style>
  .feature {
    container-type: inline-size;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    color: #fff;
    background: radial-gradient(ellipse at 91% 32%, #55468d 0%, transparent 63%), #302858;
    border-radius: 22px;
    box-shadow: var(--study-shadow);
  }
  .feature::before {
    content: "";
    position: absolute;
    inset: 0 0 0 35%;
    z-index: -1;
    background: radial-gradient(circle, #b4a9df 1px, transparent 1.2px) 50% 50% / 19px 19px;
    opacity: .2;
  }
  .story { position: relative; z-index: 1; padding: 1.5rem; }
  .format { margin: 0 0 .85rem; font-size: .8125rem; line-height: 1.4; font-weight: 650; color: #ded6fa; }
  .format span { padding-inline: .17em; }
  .feature h2 { margin: 0; color: inherit; font-size: 1.75rem; font-weight: 700; line-height: 1.21; letter-spacing: -.025em; }
  .description { max-width: 24rem; margin: .85rem 0 1rem; color: #e8e2f8; font-size: 1rem; line-height: 1.5; word-break: keep-all; overflow-wrap: anywhere; }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: .2rem .9rem; }
  .actions a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; font-size: .8125rem; font-weight: 700; }
  .start { gap: .5rem; padding: .625rem 1rem; border-radius: 999px; background: #f6f2ff; color: #382667; }
  .contents { gap: .3rem; color: #f4eeff; }
  .contents span { font-size: 1.25rem; line-height: 1; }
  .actions a:focus-visible { outline: 3px solid #ffe0a7; outline-offset: 3px; }
  .actions a:hover { text-decoration: underline; }
  .atlas { display: block; width: 74%; max-width: 16rem; height: auto; margin: -.25rem auto .5rem; }
  @container (min-width: 31rem) {
    .story { width: 58%; padding: 1.75rem; }
    .atlas { position: absolute; inset: 50% 0 auto auto; width: 45%; max-width: 24rem; margin: 0; transform: translateY(-50%); }
  }
  @container (min-width: 42rem) {
    .story { padding: 2.15rem; }
    .feature h2 { font-size: 2.125rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .start { transition: transform 200ms cubic-bezier(.2,.8,.2,1); }
    .start:active { transform: scale(.97); }
  }
</style>
