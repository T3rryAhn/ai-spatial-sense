---
import { chapters, parts, scenes } from '../generated/slides.json';
---
<div class="scene-list not-content">
{Object.entries(parts).map(([part, info]) => (
  <section class="part" aria-label={`${info[0]} · ${info[1]}`}>
    <h3><span>{info[0]}</span>{info[1]}</h3>
    {chapters.map((chapter, ch) => chapter.p === Number(part) && (
      <section class="chapter" aria-label={chapter.t}>
        <h4>{chapter.t}</h4>
        <ul>{scenes.filter((scene) => scene.ch === ch).map((scene) => (
          <li><a href={`/ai/spatial-sense/#${scene.number}`}>
            <span class="number">{scene.number}.</span>
            <span>{scene.title}</span>
            <span class="arrow" aria-hidden="true">›</span>
          </a></li>
        ))}</ul>
      </section>
    ))}
  </section>
))}
</div>

<style>
  .part { border: 1px solid var(--study-separator); border-radius: 18px; background: var(--study-surface); padding: 1.25rem; }
  .part + .part { margin-top: 1.25rem; }
  h3 { display: flex; align-items: baseline; flex-wrap: wrap; gap: .4rem .65rem; margin: 0; color: var(--sl-color-white); font-size: 1.375rem; line-height: 1.3; letter-spacing: -.02em; }
  h3 span { color: var(--sl-color-text-accent); font-size: .9375rem; font-weight: 700; }
  h4 { margin: 1.2rem 0 .25rem; color: var(--study-secondary); font-size: .8125rem; line-height: 1.4; }
  ul { padding: 0; margin: 0; list-style: none; }
  li + li { border-top: 1px solid var(--study-separator); }
  a { display: grid; grid-template-columns: 2ch minmax(0,1fr) auto; align-items: baseline; column-gap: .8rem; padding: .65rem .2rem; min-height: 44px; color: var(--sl-color-white); text-decoration: none; line-height: 1.48; word-break: keep-all; overflow-wrap: anywhere; }
  .number { color: var(--sl-color-text-accent); text-align: end; font-size: .8125rem; font-variant-numeric: tabular-nums; font-weight: 650; }
  .arrow { color: var(--study-secondary); }
  a:hover span:nth-child(2) { text-decoration: underline; }
  @media (max-width: 25rem) { .part { padding: 1rem; } }
</style>
