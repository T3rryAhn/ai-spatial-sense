---
import Pagination from '@astrojs/starlight/components/Pagination.astro';

const feedback = new URL('https://t3rryahn.duckdns.org/feedback/');
feedback.searchParams.set('service', 'study');
feedback.searchParams.set('from', Astro.url.pathname);
---
<Pagination />
<a class="feedback-link" href={feedback.href}>
  <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round">
    <path d="M5 4.5h14A1.5 1.5 0 0 1 20.5 6v9a1.5 1.5 0 0 1-1.5 1.5h-8l-5 4v-4H5A1.5 1.5 0 0 1 3.5 15V6A1.5 1.5 0 0 1 5 4.5Z" />
    <path d="M8 9h8M8 12h5" stroke-linecap="round" />
  </svg>
  의견 보내기
</a>
