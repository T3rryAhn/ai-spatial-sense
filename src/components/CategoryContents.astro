---
import { getCollection } from 'astro:content';
const { category } = Astro.props;
const docs = (await getCollection('docs'))
  .filter((doc) => doc.id.startsWith(category + '/') && doc.id !== category + '/index')
  .sort((a, b) => (a.data.sidebar?.order ?? Infinity) - (b.data.sidebar?.order ?? Infinity)
    || a.data.title.localeCompare(b.data.title, 'ko'));
---
{docs.length ? <ul class="doc-list not-content">{docs.map((doc) => (
  <li><a href={`/${doc.id}/`}>{doc.data.title}<span aria-hidden="true">›</span></a></li>
))}</ul> : <p class="empty">등록된 문서는 아직 없습니다.</p>}

<style>
  .doc-list, .empty { padding: .4rem 1rem; border: 1px solid var(--study-separator); border-radius: 16px; background: var(--study-surface); }
  .empty { padding: 1rem; color: var(--study-secondary); }
  .doc-list { list-style: none; }
  li + li { border-top: 1px solid var(--study-separator); }
  a { display: flex; justify-content: space-between; align-items: center; gap: .7rem; padding: .5rem 0; min-height: 44px; color: var(--sl-color-text-accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  a span { color: var(--study-secondary); font-size: 1.25rem; }
</style>
